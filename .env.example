# Adatbazis. Alapertelmezett: helyi SQLite fajl. Postgres-re valtashoz peldaul:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/loyalty
DATABASE_URL=sqlite:///./data/loyalty.db

# UNAS API
UNAS_API_BASE_URL=https://api.unas.eu/shop
UNAS_API_KEY=
UNAS_LOYALTY_PARAM_ID=6590861
UNAS_WEBHOOK_HMAC_SECRET=
UNAS_MAX_REQUESTS_PER_SECOND=5
UNAS_REQUEST_TIMEOUT_SECONDS=30

# QR / token
LOYALTY_QR_PREFIX=unas-loyalty:v1:
LOYALTY_TOKEN_MAX_LENGTH=64

# Uzleti szabalyok - ELES INDULAS ELOTT KOTELEZO KITOLTENI VALOS ERTEKKEL
# rule mode: jelenleg csak "per_currency_unit" (osszegalapu) tamogatott
LOYALTY_POINTS_RULE_MODE=per_currency_unit
LOYALTY_POINTS_PER_CURRENCY_UNIT=0
LOYALTY_POINTS_ROUNDING=floor
LOYALTY_REDEMPTION_VALUE_PER_POINT=0
LOYALTY_REDEMPTION_MIN_POINTS=0
LOYALTY_REDEMPTION_MAX_POINTS_PER_TX=0

# Session / biztonsag
SESSION_SECRET=
APP_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
